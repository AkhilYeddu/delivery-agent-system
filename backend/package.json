{
  "name": "delivery-agent-backend",
  "version": "1.0.0",
  "description": "Node.js REST API with PostgreSQL and Redis caching for Delivery Agent Management",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "node -e \"console.log('Backend JavaScript ready')\"",
    "start": "node src/index.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:prod": "node src/db/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
