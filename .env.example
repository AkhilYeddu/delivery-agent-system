# ==============================================================================
# Delivery Agent Management System - Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Configuration
# Example standard Postgres connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivery_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=delivery_db

# Fallback Mode:
# When set to 'true' or if local Postgres is unreachable, the server automatically
# uses an embedded PGlite instance (.pgdata/) so the app runs out-of-the-box.
USE_PGLITE_FALLBACK=true

# Redis Configuration
# Example Redis URL:
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Cache TTL (in seconds)
REDIS_CACHE_TTL_LIST=300
REDIS_CACHE_TTL_DETAIL=600
REDIS_CACHE_TTL_STATS=180

# Fallback to in-memory cache if Redis is not running
USE_MEMORY_CACHE_FALLBACK=true
